	/*=============================================
	GENERAR FACTURA ELECTRÓNICA
	=============================================*/
	static public function ctrGenerarFacturaElectronica($idVenta) {
		// 1. Obtener datos de la venta
		require_once "modelos/ventas.modelo.php";
		require_once "modelos/clientes.modelo.php";
		require_once "modelos/productos.modelo.php";

		$venta = ModeloVentas::mdlMostrarVentas("ventas", "id", $idVenta);

		if (!$venta) {
			return array(
				"error" => true,
				"mensaje" => "Venta no encontrada"
			);
		}

		// 2. Obtener token
		$auth = self::ctrAutenticar();
		if ($auth['error']) {
			return array(
				"error" => true,
				"mensaje" => "Error de autenticación: " . $auth['mensaje']
			);
		}

		// 3. Preparar datos de la factura según formato de Factus
		$datosFactura = self::prepararDatosFactura($venta);

		// 4. Enviar factura a Factus
		$resultado = ModeloFactus::mdlCrearFacturaElectronica($auth['token'], $datosFactura);

		// 5. Procesar respuesta
		if ($resultado['http_code'] == 201 || $resultado['http_code'] == 200) {
			$respuestaFactus = json_decode($resultado['respuesta'], true);

			// Actualizar datos en la venta
			$datosActualizar = array(
				"estado_dian" => "Enviado",
				"cufe" => $respuestaFactus['cufe'] ?? '',
				"qr_data" => $respuestaFactus['qr_code'] ?? '',
				"xml_dian" => $respuestaFactus['xml_url'] ?? '',
				"pdf_dian" => $respuestaFactus['pdf_url'] ?? '',
				"mensaje_dian" => $respuestaFactus['message'] ?? 'Factura generada exitosamente',
				"fecha_envio_dian" => date('Y-m-d H:i:s')
			);

			ModeloFactus::mdlActualizarDatosFactura($idVenta, $datosActualizar);

			return array(
				"error" => false,
				"mensaje" => "Factura electrónica generada exitosamente",
				"datos" => $respuestaFactus
			);
		} else {
			// Error al generar factura
			$error = json_decode($resultado['respuesta'], true);

			$datosActualizar = array(
				"estado_dian" => "Error",
				"cufe" => '',
				"qr_data" => '',
				"xml_dian" => '',
				"pdf_dian" => '',
				"mensaje_dian" => $error['message'] ?? $resultado['respuesta'],
				"fecha_envio_dian" => date('Y-m-d H:i:s')
			);

			ModeloFactus::mdlActualizarDatosFactura($idVenta, $datosActualizar);

			return array(
				"error" => true,
				"mensaje" => "Error al generar factura: " . ($error['message'] ?? 'Error desconocido'),
				"codigo_http" => $resultado['http_code'],
				"detalles" => $resultado['respuesta']
			);
		}
	}

	/*=============================================
	PREPARAR DATOS DE FACTURA PARA FACTUS
	=============================================*/
	private static function prepararDatosFactura($venta) {
		require_once "modelos/clientes.modelo.php";
		require_once "modelos/productos.modelo.php";
		require_once "modelos/configuracion.modelo.php";

		// Obtener datos del cliente
		$cliente = ModeloClientes::mdlMostrarClientes("clientes", "id", $venta['id_cliente']);

		// Obtener configuración de la empresa
		$config = ModeloConfiguracion::mdlObtenerConfiguracion();

		// Decodificar productos de la venta
		$productosVenta = json_decode($venta['productos'], true);
		$items = array();

		foreach ($productosVenta as $productoVenta) {
			// Obtener datos completos del producto desde la BD
			$productoBD = ModeloProductos::mdlMostrarProductos("productos", "id", $productoVenta['id'], "id");

			// Usar datos reales del producto o valores por defecto
			$tributoId = isset($productoBD['tributo_id']) && !empty($productoBD['tributo_id'])
				? intval($productoBD['tributo_id'])
				: 1; // IVA 19% por defecto

			$unidadMedida = isset($productoBD['unidad_medida_codigo']) && !empty($productoBD['unidad_medida_codigo'])
				? intval($productoBD['unidad_medida_codigo'])
				: 70; // Unidad por defecto

			$items[] = array(
				"code_reference" => $productoVenta['codigo'] ?? '',
				"name" => $productoVenta['descripcion'],
				"quantity" => intval($productoVenta['cantidad']),
				"discount_rate" => floatval($productoVenta['descuento'] ?? 0),
				"price" => floatval($productoVenta['precio']),
				"tax_rate" => strval(floatval($productoVenta['impuesto'] ?? 19)) . ".00",
				"unit_measure_id" => $unidadMedida,
				"standard_code_id" => 1,
				"is_excluded" => 0,
				"tribute_id" => $tributoId,
				"withholding_taxes" => array()
			);
		}

		// Usar tipo de documento y municipio reales del cliente
		$tipoDocumentoId = isset($cliente['tipo_documento_id']) && !empty($cliente['tipo_documento_id'])
			? intval($cliente['tipo_documento_id'])
			: 3; // NIT por defecto

		$municipioId = isset($cliente['municipio_id']) && !empty($cliente['municipio_id'])
			? intval($cliente['municipio_id'])
			: 980; // Bogotá por defecto según tabla factus_municipios

		// Usar método de pago DIAN de la venta
		$metodoPagoDianId = isset($venta['metodo_pago_dian_id']) && !empty($venta['metodo_pago_dian_id'])
			? strval($venta['metodo_pago_dian_id'])
			: "10"; // Efectivo por defecto

		// Preparar estructura de factura según API de Factus
		$factura = array(
			"document" => "01", // 01 = Factura de venta
			"numbering_range_id" => 1, // ID del rango de numeración (debe existir en Factus)
			"reference_code" => "VENTA-" . $venta['codigo'],
			"observation" => $venta['notas'] ?? '',
			"payment_method_code" => $metodoPagoDianId,
			"establishment" => array(
				"name" => $config['nombre_empresa'] ?? 'Mi Empresa',
				"address" => $config['direccion_empresa'] ?? 'Dirección',
				"phone_number" => $config['telefono_empresa'] ?? '1234567',
				"email" => $config['email_empresa'] ?? 'empresa@example.com',
				"municipality_id" => 980 // Bogotá
			),
			"customer" => array(
				"identification" => $cliente['documento'] ?? '',
				"dv" => "0",
				"company" => "",
				"trade_name" => "",
				"names" => $cliente['nombre'],
				"address" => $cliente['direccion'] ?? '',
				"email" => $cliente['email'] ?? '',
				"phone" => $cliente['telefono'] ?? '',
				"legal_organization_id" => "2",
				"tribute_id" => "21",
				"identification_document_id" => $tipoDocumentoId,
				"municipality_id" => strval($municipioId)
			),
			"items" => $items
		);

		return $factura;
	}
}
